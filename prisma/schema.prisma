// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../prisma"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  PROFESSOR
  ADMIN
}

model User {
  id           Int      @id @default(autoincrement())
  role         Role     @default(STUDENT)
  name         String?
  email        String   @unique
  passwordHash String?
  image        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  questionRequestTemplates QuestionRequestTemplate[]
  questionRequests         QuestionRequest[]
  answers                  Answer[]
  evaluationTemplates      EvaluationTemplate[]
  evaluationCriterions     EvaluationCriterion[]
  ownedClasses             Class[]                   @relation("ClassOwner")
  studentClasses           Class[]                   @relation("ClassStudents")
  collaboratedClasses      ClassCollaborator[]
  feedbackSummaries        StudentTemplateFeedbackSummary[]
  llmUsages                LlmUsage[]
}

model Topic {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuestionRequestTemplate {
  id             Int      @id @default(autoincrement())
  name           String
  promptTemplate String
  visible        Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  /// [QuestionRequestTemplateParameter]
  parameters     Json[]
  ownerId        Int

  owner User @relation(fields: [ownerId], references: [id])

  requests             QuestionRequest[]
  evaluationTemplate   EvaluationTemplate? @relation(fields: [evaluationTemplateId], references: [id])
  evaluationTemplateId Int?
  classes              Class[]
  feedbackSummaries    StudentTemplateFeedbackSummary[]
  llmUsages            LlmUsage[]
}

enum QuestionRequestStatus {
  PENDING
  COMPLETED
  CANCELED
  FAILED
}

model QuestionRequest {
  id              Int                   @id @default(autoincrement())
  status          QuestionRequestStatus @default(PENDING)
  /// [QuestionRequestParameterValue]
  parameterValues Json[]
  createdAt       DateTime              @default(now())

  templateId Int?
  userId     Int

  user      User                     @relation(fields: [userId], references: [id])
  template  QuestionRequestTemplate? @relation(fields: [templateId], references: [id])
  questions Question[]
}

model Question {
  id                 Int    @id @default(autoincrement())
  content            String
  correctAnswerIndex Int? /// [MultipleChoiceQuestionAlternative]
  alternatives       Json[]
  type               String @default("multiple-choice")
  evaluationCriteria Json[]

  requestId Int
  request   QuestionRequest @relation(fields: [requestId], references: [id])

  answers Answer[]
}

model EvaluationTemplate {
  id               Int      @id @default(autoincrement())
  name             String
  description      String?
  evaluationPrompt String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id])

  criteria                 EvaluationTemplateCriterion[]
  questionRequestTemplates QuestionRequestTemplate[]
  classes                  Class[]
}

model EvaluationTemplateCriterion {
  id     Int   @id @default(autoincrement())
  weight Float
  order  Int   @default(0)

  criterionId Int
  criterion   EvaluationCriterion @relation(fields: [criterionId], references: [id])

  templateId Int
  template   EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  autoEvaluationCriteria AutoEvaluationCriterion[]

  @@unique([templateId, criterionId])
}

model EvaluationCriterion {
  id          Int      @id @default(autoincrement())
  name        String   @default("")
  description String
  createdAt   DateTime @default(now())

  ownerId Int
  owner   User @relation(fields: [ownerId], references: [id])

  templates EvaluationTemplateCriterion[]
}

model Answer {
  id         Int @id @default(autoincrement())
  questionId Int
  userId     Int

  answerIndex     Int?
  correct         Boolean
  confidenceLevel Int
  openAnswer      String?
  createdAt       DateTime @default(now())

  flaggedIncorrect   Boolean @default(false)
  flaggedProblematic Boolean @default(false)
  flaggedExcellent   Boolean @default(false)
  observation        String  @default("")

  question Question @relation(fields: [questionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  autoEvaluation AutoEvaluation?

  @@index([userId, questionId], name: "user_question_unique")
}

model AutoEvaluation {
  id       Int    @id @default(autoincrement())
  answer   Answer @relation(fields: [answerId], references: [id])
  answerId Int    @unique

  score         Float
  justification String
  modelVersion  String?

  criteria    AutoEvaluationCriterion[]
  evaluatedAt DateTime                  @default(now())
}

model AutoEvaluationCriterion {
  id               Int            @id @default(autoincrement())
  autoEvaluation   AutoEvaluation @relation(fields: [autoEvaluationId], references: [id])
  autoEvaluationId Int

  templateCriterion   EvaluationTemplateCriterion? @relation(fields: [templateCriterionId], references: [id])
  templateCriterionId Int?

  description String
  weight      Float
  score       Float
}

model Class {
  id        Int      @id @default(autoincrement())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownerId             Int
  owner               User                      @relation("ClassOwner", fields: [ownerId], references: [id])
  students            User[]                    @relation("ClassStudents")
  collaborators       ClassCollaborator[]
  questionTemplates   QuestionRequestTemplate[]
  evaluationTemplates EvaluationTemplate[]
  link                String                    @unique
  llmUsages           LlmUsage[]

}

model ClassCollaborator {
  classId Int
  userId  Int
  addedAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
}

enum LlmUsageType {
  QUESTION_GENERATION
  ANSWER_EVALUATION
  PERFORMANCE_SUMMARY
}

model LlmUsage {
  id               Int          @id @default(autoincrement())
  type             LlmUsageType
  promptTokens     Int
  completionTokens Int
  model            String
  createdAt        DateTime     @default(now())

  userId Int?
  user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  classId Int?
  class   Class? @relation(fields: [classId], references: [id], onDelete: SetNull)

  templateId Int?
  template   QuestionRequestTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

model StudentTemplateFeedbackSummary {
  id        Int      @id @default(autoincrement())
  summary   String
  updatedAt DateTime @updatedAt

  studentId  Int
  templateId Int

  student  User                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template QuestionRequestTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([studentId, templateId])
}
